# Copy to .env to override defaults. Compose supplies the Postgres values itself;
# these matter when running the services directly on the host.
SCANNER_POSTGRES_HOST=localhost
SCANNER_POSTGRES_PORT=5432
SCANNER_POSTGRES_USER=scanner
SCANNER_POSTGRES_PASSWORD=scanner
SCANNER_POSTGRES_DB=scanner

# The brief asks for 15 minutes. Per-image overrides live in image.scan_interval_seconds.
SCANNER_DEFAULT_SCAN_INTERVAL_SECONDS=900

# There is no client-side registry rate limit to configure: throttling is taken from
# the registry's own 429 + Retry-After. See README, "The registry is the binding
# constraint -- but it is not ours to model".

SCANNER_TRIVY_CACHE_DIR=/trivy-cache

# Logs are JSON so that job_id / image / digest are filterable fields rather than
# prose. Set to text when tailing them by eye.
SCANNER_LOG_FORMAT=json
SCANNER_LOG_LEVEL=INFO
